# Copiar a .env y completar localmente. Nunca subir .env a Git.

PORT=4000
NODE_ENV=development

# Origen permitido para CORS (frontend)
ORIGEN_PERMITIDO=http://localhost:5173

# Secretos del proveedor de LLM (definir cuando se integre el orquestador de IA).
# LLM_API_KEY=

# Configuracion de base de datos (definir cuando se elija el motor de persistencia).
# DATABASE_URL=
